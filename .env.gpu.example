# Copy this file to .env.gpu on an NVIDIA accelerator host. It is intentionally
# separate from .env so `just up` keeps the CPU-safe defaults.
#
# A Hugging Face token is needed only for gated models or higher Hub limits.
HF_TOKEN=""

# The standard GPU profile serves this model and config.gpu.yaml routes all
# logical aliases to it. Choose a different profile/config before changing it.
VLLM_MODEL="Qwen/Qwen2.5-7B-Instruct"
VLLM_SERVED_MODEL_NAME="Qwen/Qwen2.5-7B-Instruct"
VLLM_DTYPE="bfloat16"
VLLM_MAX_MODEL_LEN="8192"
VLLM_GPU_MEM_UTIL="0.90"

# Set this to the number of GPUs available to this vLLM container when a model
# is sharded across them. Keep it at 1 for a single GPU.
VLLM_TENSOR_PARALLEL_SIZE="1"
VLLM_PIPELINE_PARALLEL_SIZE="1"
VLLM_MAX_NUM_SEQS="128"
VLLM_SWAP_SPACE_GB="4"

# CUDA device visibility. For a subset, use a comma-separated list such as 0,1
# and make VLLM_TENSOR_PARALLEL_SIZE match the number of visible GPUs.
NVIDIA_VISIBLE_DEVICES="all"
NVIDIA_DRIVER_CAPABILITIES="compute,utility"

VLLM_PORT="8001"
EXECUTION_MODE="real"
