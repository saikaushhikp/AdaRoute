GOOGLE_API_KEY=""
COHERE_CHAT_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""

# Hugging Face token — required to download gated models (e.g. Llama, Qwen)
HF_TOKEN=""

# vLLM configuration (used by docker-compose and VLLMBackend)
# VLLM_BASE_URL is auto-set to http://vllm:8000/v1 inside Docker
VLLM_BASE_URL=""
VLLM_API_KEY=""
VLLM_MODEL="Qwen/Qwen2.5-1.5B-Instruct"
VLLM_SERVED_MODEL_NAME="Qwen/Qwen2.5-1.5B-Instruct"
VLLM_DTYPE="float16"
VLLM_MAX_MODEL_LEN="4096"
VLLM_GPU_MEM_UTIL="0.85"
VLLM_PORT="8001"

# Gateway execution mode: real | simulation | hybrid (default)
EXECUTION_MODE="hybrid"
